# =============================================================================
# Bamero Production Environment Configuration
# =============================================================================
# IMPORTANT: This file contains template values. Copy to .env and fill with real values.
# NEVER commit the real .env file to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# WordPress Database Configuration
# -----------------------------------------------------------------------------
DB_NAME=bamero_production
DB_USER=bamero_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# -----------------------------------------------------------------------------
# WordPress Core Configuration
# -----------------------------------------------------------------------------
WP_DEBUG=0
WP_DEBUG_DISPLAY=0
WP_DEBUG_LOG=0
DISALLOW_FILE_MODS=1
FORCE_SSL_ADMIN=1
WP_CACHE=1
WP_CACHE_KEY_SALT=your-domain.com

# -----------------------------------------------------------------------------
# WooCommerce Configuration
# -----------------------------------------------------------------------------
WOOCOMMERCE_CURRENCY=IRR
WOOCOMMERCE_WEIGHT_UNIT=kg
WOOCOMMERCE_DIMENSION_UNIT=cm
WOOCOMMERCE_ENABLE_COUPONS=no
WOOCOMMERCE_ENABLE_MYACCOUNT_REGISTRATION=no
WOOCOMMERCE_ENABLE_GUEST_CHECKOUT=yes
WOOCOMMERCE_SHIP_TO_COUNTRIES=IR
WOOCOMMERCE_ALLOWED_COUNTRIES=IR

# -----------------------------------------------------------------------------
# Bamero Environment Configuration
# -----------------------------------------------------------------------------
# Set to 'production' for live site, 'staging' for testing
BAMERO_ENVIRONMENT=production

# Internal ID salt for generating synthetic email addresses
BAMERO_INTERNAL_ID_SALT=your_random_salt_string_here

# -----------------------------------------------------------------------------

# ZarinPal Payment Gateway Configuration
# -----------------------------------------------------------------------------
# Production: https://payment.zarinpal.com/pg/v4
# Sandbox: https://sandbox.zarinpal.com/pg/v4
ZARINPAL_MERCHANT_ID=your_merchant_id_from_zarinpal
ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4
ZARINPAL_STARTPAY_URL=https://payment.zarinpal.com/pg/StartPay
ZARINPAL_CURRENCY=IRR

# -----------------------------------------------------------------------------
# SMS.ir Provider Configuration
# -----------------------------------------------------------------------------
SMS_PROVIDER=sms_ir
SMS_IR_API_KEY=your_api_key_from_sms_ir
SMS_IR_API_BASE_URL=https://api.sms.ir/v1

# Template IDs for SMS notifications
SMS_IR_TEMPLATE_LOGIN_OTP=your_otp_template_id
SMS_IR_TEMPLATE_ORDER_PROCESSING=your_order_processing_template_id
SMS_IR_TEMPLATE_ORDER_DELIVERED=your_order_delivered_template_id
SMS_IR_TEMPLATE_ORDER_CANCELLED=your_order_cancelled_template_id
SMS_IR_TEMPLATE_PAYMENT_FAILED=your_payment_failed_template_id

# SMS parameter names (customize if needed)
SMS_IR_OTP_PARAMETER=Code
SMS_IR_ORDER_PARAMETER=OrderId
SMS_IR_NAME_PARAMETER=Name

# Timeout for SMS API calls (seconds)
SMS_TIMEOUT=5

# -----------------------------------------------------------------------------
# Staging Environment Flags
# -----------------------------------------------------------------------------
# Set to 'true' to enable payment/SMS in staging (for testing only)
BAMERO_ENABLE_PAYMENT_IN_STAGING=false
BAMERO_ENABLE_SMS_IN_STAGING=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# WordPress Security Keys (generate new ones: https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY=put_your_unique_phrase_here
SECURE_AUTH_KEY=put_your_unique_phrase_here
LOGGED_IN_KEY=put_your_unique_phrase_here
NONCE_KEY=put_your_unique_phrase_
here
AUTH_SALT=put_your_unique_phrase_here
SECURE_AUTH_SALT=put_your_unique_phrase_here
LOGGED_IN_SALT=put_your_unique_phrase_here
NONCE_SALT=put_your_unique_phrase_here

# -----------------------------------------------------------------------------
# Redis Cache Configuration (Optional)
# -----------------------------------------------------------------------------
WP_REDIS_HOST=127.0.0.1
WP_REDIS_PORT=6379
WP_REDIS_TIMEOUT=1
WP_REDIS_PREFIX=wp_
WP_REDIS_DISABLED=0

# -----------------------------------------------------------------------------
# Email Configuration (Admin only, customer emails disabled)
# -----------------------------------------------------------------------------
# SMTP settings for admin notifications only
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=admin@your-domain.com
SMTP_FROM_NAME=Bamero
SMTP_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# Health Check Endpoint (health-check.php)
# -----------------------------------------------------------------------------
# Required in production to enable the token-protected health endpoint
# (ships with the release artifact). Without a token the endpoint answers
# HTTP 403. Generate with: openssl rand -hex 32
BAMERO_HEALTH_TOKEN=your_generated_health_token_here

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# NOTE: these are hosting-panel PHP settings (php.ini / PHP-FPM pool).
# wp-config.php does NOT read them from .env. Recommended production values:
#   upload_max_filesize = 64M
#   post_max_size = 64M
#   memory_limit = 256M
#   max_execution_time = 300

# -----------------------------------------------------------------------------
# Domain and URL Configuration
# -----------------------------------------------------------------------------
# Main domain (without protocol)
DOMAIN=your-domain.com

# WordPress URLs — LITERAL full values (the .env loader does NOT expand variables)
WP_HOME=https://your-domain.com
WP_SITEURL=https://your-domain.com

# -----------------------------------------------------------------------------
# Database Table Prefix — read by wp-config.php as TABLE_PREFIX
# Use a custom prefix; never the default wp_
# -----------------------------------------------------------------------------
TABLE_PREFIX=wp_bamero_

# -----------------------------------------------------------------------------
# Additional WooCommerce Settings
# -----------------------------------------------------------------------------
# Enable HPOS (High-Performance Order Storage)
WOOCOMMERCE_USE_COT=
true

# -----------------------------------------------------------------------------
# Log Configuration
# -----------------------------------------------------------------------------
# Enable/disable logging
BAMERO_LOG_ENABLED=1
BAMERO_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Real Cron (recommended for production)
# -----------------------------------------------------------------------------
# Set to 1 ONLY after creating the host cron job (GO_LIVE_RUNBOOK_FA.md section 3)
DISABLE_WP_CRON=0

# -----------------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------------
# Set to '1' to enable maintenance mode
BAMERO_MAINTENANCE_MODE=0
BAMERO_MAINTENANCE_MESSAGE="در حال به‌روزرسانی. لطفاً بعداً امتحان کنید."

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 1. NEVER commit this file with real values to Git!
# 2. Copy this file to .env and fill with your actual values
# 3. Keep .env file secure (permissions: 400 or 440)
# 4. For production, ALL secrets must be set in the environment
# 5. Test all configurations in staging before deploying to production
# =============================================================================
