# Bamero — runtime environment template.
#
# HOW TO USE ON PHP HOSTING:
#   1. Copy this file to ".env" (keep the dot).
#   2. Fill in every value below (no quotes needed).
#   3. Upload it OUTSIDE the web root (recommended) as "../bamero.env",
#      or inside the web root as ".env" (it is blocked from HTTP by .htaccess).
#   The wp-config.php loader reads it automatically. Real environment variables
#   set in the hosting panel always take precedence over this file.
#
# NEVER commit a real .env to git. This file lists ONLY variables the runtime
# code actually reads.

# --- Database (from hosting panel) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
TABLE_PREFIX=wp_bamero_

# --- Site domain (optional) ---
# Set these to pin the site URL without editing the database.
# Example: WP_HOME=https://rang.example.ir  (no trailing slash)
WP_HOME=
WP_SITEURL=

# --- WordPress salts/keys (generate 8 unique random values) ---
# Generate at: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# --- Runtime flags ---
WP_ENVIRONMENT_TYPE=production
WP_DEBUG=0
WP_DEBUG_LOG=0
DISALLOW_FILE_MODS=1
# Page cache flag: set to 1 ONLY after installing/activating WP Super Cache (or another cache plugin).
WP_CACHE=0

# Salt used to derive the internal, non-routable customer identifier mailbox.
# Required by the WordPress user schema; never used for auth or messaging.
BAMERO_INTERNAL_ID_SALT=

# --- Mobile-only transactional notification provider (SMS.ir) ---
SMS_PROVIDER=sms_ir
SMS_TIMEOUT=5
SMS_IR_API_BASE_URL=https://api.sms.ir/v1
SMS_IR_API_KEY=
SMS_IR_OTP_PARAMETER=Code
SMS_IR_ORDER_PARAMETER=OrderId
SMS_IR_TEMPLATE_LOGIN_OTP=
SMS_IR_TEMPLATE_ORDER_PROCESSING=
SMS_IR_TEMPLATE_ORDER_DELIVERED=
SMS_IR_TEMPLATE_ORDER_CANCELLED=
SMS_IR_TEMPLATE_PAYMENT_FAILED=
SMS_IR_TEMPLATE_REFUND_COMPLETED=

# --- Zarinpal official v4 request/verify API ---
ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4
ZARINPAL_STARTPAY_URL=https://payment.zarinpal.com/pg/StartPay
ZARINPAL_MERCHANT_ID=
ZARINPAL_CURRENCY=IRT
BAMERO_PAYMENT_WEBHOOK_SECRET=